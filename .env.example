# -----------------------------------------------------------------------------
# Sistem KPI PT Berlian Artha Label — contoh konfigurasi environment.
# File ini TIDAK boleh berisi secret. Salin ke `.env`, lalu isi nilai lokal.
# Nilai di bawah adalah TARGET arsitektur (ADR-0003/0004). Layanan PostgreSQL,
# Redis, object storage, dan mail catcher disediakan Docker Compose pada Step 03.
# -----------------------------------------------------------------------------

APP_NAME="KPI Berlian Artha Label"
APP_ENV=local
# Dibuat dengan `php artisan key:generate`; jangan commit nilainya.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Zona waktu presentasi/bisnis (deadline, periode, tampilan) — ADR-0007.
# Runtime PHP dan penyimpanan timestamp tetap UTC (config/app.php 'timezone').
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Identity & access (Step 05). DEC-013 masih OPEN: hanya provider "local" yang
# tersedia dan MFA belum diwajibkan. Lihat docs/architecture/IDENTITY_ACCESS.md.
IDENTITY_PROVIDER=local
IDENTITY_MFA_REQUIRED=false

# Tanggal berlaku struktur referensi 21 team. Wajib diisi (dikonfirmasi HR)
# sebelum seed production; non-production memakai placeholder tanggal PRD.
ORGANIZATION_REFERENCE_EFFECTIVE_FROM=

# Password bersama akun fiktif [DEV] (APP_ENV=local saja). Kosong = acak, dicetak sekali.
DEV_SEED_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 adalah source of truth (ADR-0003).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kpi_berlianartha
DB_USERNAME=kpi_app
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log

# Redis untuk cache dan queue (bukan penyimpan business state).
# Tanpa Redis lokal, ubah sementara di `.env`: CACHE_STORE=database, QUEUE_CONNECTION=database.
CACHE_STORE=redis
CACHE_PREFIX=kpi_bal_cache_
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=kpi_bal_

# Disk default lokal untuk development. Evidence/export memakai private
# S3-compatible object storage (ADR-0004); bucket tidak boleh public.
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Evidence (Step 08). Bucket tetap private; file dibuka lewat tautan
# bertanda tangan berumur pendek. Belum ada antivirus: "none" menahan semua
# file di karantina, "local-unscanned" hanya diterima pada APP_ENV=local.
EVIDENCE_DISK=s3
EVIDENCE_SCANNER=local-unscanned
EVIDENCE_LINK_TTL=300

# Step 11. Email notifikasi tetap nonaktif sampai layanan email disetujui (DEC-014).
NOTIFICATION_EMAIL_ENABLED=false
# Bukti penyelesaian corrective action wajib sebelum verifikasi (PRD 9.2 "bila dikonfigurasi").
TEAM_REVIEW_COMPLETION_EVIDENCE_REQUIRED=false
# Tautan https ke approval cuti di sistem HR; kosong = belum ditetapkan.
HRIS_LEAVE_URL=
# Ambang skor KPI merah pada dashboard; kosong sampai disetujui (DEC-004).
DASHBOARD_RED_KPI_SCORE_BELOW=

# Step 12. Disk private untuk file ekspor laporan dan batas teknisnya.
# Retensi file ekspor adalah batas teknis, bukan kebijakan retensi data (DEC-010).
REPORT_EXPORT_DISK=s3
REPORT_EXPORT_LINK_TTL=300
REPORT_EXPORT_RETENTION_HOURS=72

# Step 14. Department yang memegang data piutang (PRD: group Accounting).
ACCOUNTING_DEPARTMENT_CODE=ACC

# Step 15. Department produksi dan team pemegang board PPIC (PRD §4).
PRODUCTION_DEPARTMENT_CODE=PROD
PPIC_UNIT_CODE=COMSUP-ADMIN-PPIC

# Step 16. Team pemilik workflow NCR dan CAPA (PRD §10.3).
QC_UNIT_CODE=PROD-QC

# Step 17. Integration drop zone and connections. Every connection stays off
# until DEC-008 approves it. Keys and run-as accounts come from the secret
# store; never commit values here.
INTEGRATION_DISK=local
INTEGRATION_ROOT=integration
INTEGRATION_MAX_ATTEMPTS=3
INTEGRATION_ERP_RECEIVABLES_ENABLED=false
INTEGRATION_ERP_RECEIVABLES_HMAC_KEY=
INTEGRATION_ERP_RECEIVABLES_RUN_AS=
INTEGRATION_MES_PRODUCTION_ENABLED=false
INTEGRATION_MES_PRODUCTION_HMAC_KEY=
INTEGRATION_MES_PRODUCTION_RUN_AS=
INTEGRATION_MES_PACKING_ENABLED=false
INTEGRATION_MES_PACKING_HMAC_KEY=
INTEGRATION_MES_PACKING_RUN_AS=
INTEGRATION_TMS_DELIVERY_ENABLED=false
INTEGRATION_TMS_DELIVERY_HMAC_KEY=
INTEGRATION_TMS_DELIVERY_RUN_AS=
INTEGRATION_ERP_WORK_ORDERS_ENABLED=false
INTEGRATION_ERP_WORK_ORDERS_HMAC_KEY=
INTEGRATION_ERP_WORK_ORDERS_RUN_AS=
INTEGRATION_WMS_STOCK_ENABLED=false
INTEGRATION_WMS_STOCK_HMAC_KEY=
INTEGRATION_WMS_STOCK_RUN_AS=
INTEGRATION_QMS_INSPECTION_ENABLED=false
INTEGRATION_QMS_INSPECTION_HMAC_KEY=
INTEGRATION_QMS_INSPECTION_RUN_AS=

# Mail lokal diarahkan ke mail catcher (mis. Mailpit di Step 03), bukan penerima nyata.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kpi.example.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Docker Compose (Step 03). Port hanya di-bind ke 127.0.0.1. Secret di atas
# (APP_KEY, DB_PASSWORD, AWS_*) diisi otomatis oleh `bash scripts/dev.sh bootstrap`.
# -----------------------------------------------------------------------------
APP_PORT=8088
S3_PORT=8333
MAILPIT_PORT=8025
# Linux/macOS: samakan dengan `id -u` / `id -g` agar file bind mount dapat ditulis.
# DOCKER_UID=1000
# DOCKER_GID=1000
